<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskbarRoot"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/bg_win11_taskbar"
    android:paddingStart="6dp"
    android:paddingEnd="4dp">

    <!-- Match_parent + symmetric end/start padding (set in code = tray width)
         keeps Start+apps visually centered without drawing under the tray. -->
    <LinearLayout
        android:id="@+id/taskbarCenter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonTaskbarStart"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_taskbar_btn"
            android:contentDescription="@string/multi_app_start_menu"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_win11_start" />

        <HorizontalScrollView
            android:id="@+id/taskbarAppsScroll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/taskbarWindows"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/taskbarTray"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/buttonQuickSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_taskbar_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/imageTrayWifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/multi_app_quick_settings"
                android:src="@drawable/ic_win11_wifi" />

            <ImageView
                android:id="@+id/imageTrayVolume"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/multi_app_quick_settings"
                android:src="@drawable/ic_win11_volume" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonTaskbarClock"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_taskbar_btn"
            android:gravity="center"
            android:minWidth="82dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/textTaskbarClockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1F1F"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textTaskbarClockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1F1F"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
