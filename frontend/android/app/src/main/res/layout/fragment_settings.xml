<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/settings_eyebrow"
                android:textColor="@color/auth_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tab_settings"
                android:textColor="@color/auth_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/settings_desc"
                android:textColor="@color/auth_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <include
            android:id="@+id/sectionAccount"
            layout="@layout/settings_section_account" />

        <include
            android:id="@+id/sectionAppearance"
            layout="@layout/settings_section_appearance" />

        <include
            android:id="@+id/sectionRefresh"
            layout="@layout/settings_section_refresh" />

        <include
            android:id="@+id/sectionServer"
            layout="@layout/settings_section_server" />
    </LinearLayout>
</ScrollView>
