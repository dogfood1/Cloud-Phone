<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_win11_flyout"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/textQuickSettingsError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tileWifi"
            android:layout_width="0dp"
            android:layout_height="78dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_win11_qs_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imageTileWifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_win11_wifi" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/multi_app_wifi"
                android:textColor="#1F1F1F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTileWifiSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileBluetooth"
            android:layout_width="0dp"
            android:layout_height="78dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_win11_qs_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_win11_bluetooth" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/multi_app_bluetooth"
                android:textColor="#1F1F1F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTileBluetoothSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileAirplane"
            android:layout_width="0dp"
            android:layout_height="78dp"
            android:layout_weight="1"
            android:background="@drawable/bg_win11_qs_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_win11_airplane" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/multi_app_airplane"
                android:textColor="#1F1F1F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textTileAirplaneSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/buttonMute"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/multi_app_volume"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_win11_volume" />

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="#0078D4"
            android:thumbTint="#0078D4" />

        <TextView
            android:id="@+id/textVolumeValue"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#666666"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:src="@drawable/ic_win11_brightness" />

        <SeekBar
            android:id="@+id/seekBrightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progressTint="#0078D4"
            android:thumbTint="#0078D4" />

        <TextView
            android:id="@+id/textBrightnessValue"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#666666"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
