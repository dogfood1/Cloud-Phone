<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_group_slot"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/groupSlotHeader"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:background="@color/m3_surface_container_high"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/groupDeviceCheck"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupDeviceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_group_badge"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/groupPreviewFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/auth_preview_bg"
        app:layout_constraintDimensionRatio="H,9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/groupSlotHeader">

        <TextureView
            android:id="@+id/groupDeviceTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/groupDeviceLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC0F172A"
            android:fontFamily="monospace"
            android:gravity="bottom"
            android:lineSpacingExtra="1dp"
            android:padding="6dp"
            android:scrollbars="vertical"
            android:textColor="#E2E8F0"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/groupDeviceInactive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:gravity="center"
            android:text="@string/group_device_inactive"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/groupDeviceStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:minHeight="24dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textColor="@color/auth_text_secondary"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/groupPreviewFrame" />

</androidx.constraintlayout.widget.ConstraintLayout>
