<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/auth_surface"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:elevation="2dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/groupDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/auth_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/groupDeviceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Screenshot preview -->
    <ImageView
        android:id="@+id/groupDeviceScreenshot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:background="@color/auth_preview_bg"
        android:minHeight="120dp"
        android:scaleType="fitCenter" />

    <!-- Status -->
    <TextView
        android:id="@+id/groupDeviceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/auth_surface"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:textColor="@color/auth_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
