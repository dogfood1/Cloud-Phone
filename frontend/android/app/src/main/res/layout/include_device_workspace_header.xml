<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/auth_surface"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/common_back"
        android:scaleType="center" />

    <TextView
        android:id="@+id/textDeviceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:ellipsize="end"
        android:maxWidth="88dp"
        android:maxLines="1"
        android:textColor="@color/auth_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/headerTabsScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToolFiles"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/workspace_files"
                android:textColor="@color/auth_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToolApps"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/workspace_apps"
                android:textColor="@color/auth_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonToolTerminal"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/workspace_terminal"
                android:textColor="@color/auth_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonStartCast"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="56dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="@string/workspace_start_cast"
        android:textSize="12sp"
        app:cornerRadius="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCastMode"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingLeft="6dp"
        android:paddingRight="4dp"
        android:text="@string/workspace_cast_mode"
        android:textColor="@color/auth_text_primary"
        android:textSize="13sp"
        app:iconGravity="end"
        app:iconPadding="0dp"
        app:iconSize="16dp"
        app:iconTint="@color/auth_text_secondary" />

</LinearLayout>
