<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/castRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_preview_bg">

    <include layout="@layout/include_cast_viewport" />

    <LinearLayout
        android:id="@+id/castToolbarDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/cast_panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/castToolbarScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/castToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/castToolbarToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cast_toolbar_button_bg"
            android:contentDescription="@string/cast_toolbar_collapse"
            android:padding="8dp"
            android:scaleType="centerInside" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/castErrorClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/cast_stop"
        android:visibility="gone" />

</FrameLayout>
