# Cloud Phone 环境配置（复制为 .env 后按需修改）
HOST=0.0.0.0

# 后端 API 端口（仅提供 /api 与 /health）
BACKEND_PORT=3000

# 前端页面端口（静态资源 + /api 代理到后端）
FRONTEND_PORT=5173

# 生产前端 HTTPS（Docker server.mjs 默认开启；局域网访问请用 https://<IP>:5173）
FRONTEND_HTTPS=1
# FRONTEND_TLS_SAN=192.168.1.10

# Docker Compose（docker-cloud-phone/）
# Compose 只读取 docker-cloud-phone/.env 做端口替换，根目录 .env 需：
#   cd docker-cloud-phone && ./compose.sh up -d
# 或: docker compose --env-file ../.env up -d
# 或: ln -sf ../.env docker-cloud-phone/.env && cd docker-cloud-phone && docker compose up -d
DOCKERHUB_NAMESPACE=dogfood1
# 与 package.json / APP_VERSION 一致；compose 拉取镜像时使用此 tag
IMAGE_TAG=1.21.4-redroid

# 多架构构建（build-multiarch.sh / GitHub Actions）：默认 amd64 + arm64
DOCKER_PLATFORMS=linux/amd64,linux/arm64

# Docker host 网络（Linux 默认 compose 已启用；bridge 模式设为 0）
# Mac/Windows: cd docker-cloud-phone && ./compose.sh -f docker-compose.yml -f docker-compose.bridge.yml up -d
CLOUD_PHONE_USE_HOST_NETWORK=1
# Docker 后端数据目录（compose 默认挂载 docker-cloud-phone/data -> 容器 /data）
# CLOUD_PHONE_DATA_DIR=/data
# Docker/Linux 优先使用系统 adb（镜像内 apt 安装的 android-tools-adb）
CLOUD_PHONE_PREFER_SYSTEM_ADB=1
# Linux host 网络下让容器 adb 复用宿主机 adb server，避免容器内旧 adb 重启 server
ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
# 指定 mDNS / 主 LAN IPv4（可选，默认自动选取 RFC1918 地址）
# CLOUD_PHONE_LAN_IP=192.168.1.10

# ReDroid external-camera runtime defaults
REDROID_IMAGE_TAG=redroid:13.0.0_arm64_only_extcam_rgba_blob_jpegfix_facecfg
REDROID_HOST_WORKDIR=/root/redroid-extcam
REDROID_CAMERA_VIDEO_NR=20
REDROID_CAMERA_WIDTH=1280
REDROID_CAMERA_HEIGHT=720
REDROID_CAMERA_FPS=30
REDROID_CAMERA_LENS_FACING=back
REDROID_CAMERA_SENSOR_ORIENTATION=0
REDROID_ADB_PORT_BASE=5555
REDROID_CONTAINER_ADB_PORT=5554
REDROID_ADB_AUTO_CONNECT=1
