# Cloud Phone 环境配置（复制为 .env 后按需修改）
HOST=0.0.0.0

# 后端 API 端口（仅提供 /api 与 /health）
BACKEND_PORT=3000

# 前端页面端口（静态资源 + /api 代理到后端）
FRONTEND_PORT=5173

# Docker Compose（docker-cloud-phone/）
# 拉取镜像版 docker-compose.yml 必填 DOCKERHUB_NAMESPACE（Docker Hub 用户名）
DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=latest
